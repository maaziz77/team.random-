# Private keys and certificates (never commit these: the repo is public)
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
letsencrypt/
certs/
secrets/
keys/
.deploy/

# Environment files (commit .env.example with placeholder values instead)
.env
.env.*
!.env.example

# Databases, Docker volume data, logs and uploads (made at runtime, may hold user data)
/data/
db-data/
pgdata/
mongo-data/
/volumes/
/uploads/
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump
*.bak
*.log
/logs/

# Dependencies and build output (rebuilt inside Docker)
node_modules/
.venv/
venv/
__pycache__/
dist/
build/

# OS and editor files
.DS_Store
.idea/
.vscode/
