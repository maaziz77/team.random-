# Optional settings for docker compose. Nothing here is required: without a .env file
# everything uses the defaults below.
#
# To change something, copy this file to .env (in the same folder as docker-compose.yml) and
# edit it there. .env is git-ignored: never commit it. Each person can have their own, and the
# server has its own.

# Database password. Default: a development password, fine on your laptop because the
# database is never reachable from outside. The live server MUST set a long random one.
# It's only applied when the database is first created: after changing it locally, reset your
# database with `docker compose down -v` (this deletes your local accounts).
POSTGRES_PASSWORD=

# Port the game is served on. Default 8080 (http://localhost:8080). Change it if 8080 is busy
# on your machine. On the server the deploy script sets it for you (8080 / 8081 / 8082).
APP_PORT=
